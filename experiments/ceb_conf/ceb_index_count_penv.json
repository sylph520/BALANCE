{
  "id": "CEB_Index_Count_Test",
  "description": "CEB Test Experiment with Index Count Constraint",
  "gym_version": 1,
  "timesteps": 16000,
  "database": "indexselection_job___1",
  "random_seed": 60,
  "parallel_environments": 8,
  "pickle_cost_estimation_caches": false,
  "action_manager": "MultiColumnIndexActionManager",
  "observation_manager": "SingleColumnIndexPlanEmbeddingObservationManagerWithCost",
  "reward_calculator": "RelativeDifferenceRelativeToStorageReward",
  "max_steps_per_episode": 200,
  "validation_frequency": 1000,
  "filter_utilized_columns": false,
  "max_index_width": 3,
  "reenable_indexes": false,
  "result_path": "experiment_results",
  "constraint_type": "count",
  "constraint_value": 3,
  "workload_embedder": {
    "type": "PlanEmbedderLSIBOW",
    "representation_size": 50
  },
  "rl_algorithm": {
    "algorithm": "PPO2",
    "stable_baselines_version": 2,
    "gamma": 0.99,
    "policy": "MlpPolicy",
    "model_architecture": {
      "net_arch": [
        {
          "vf": [256,256],
          "pi": [256,256]
        }
      ]
    },
    "args": {
		"learning_rate": 0.0001,
		"n_steps": 1024,
		"nminibatches": 8,
		"noptepochs": 8,
		"ent_coef": 0.0001,
		"vf_coef": 1.0,
		"lam":0.9,
		"cliprange": 0.3,
		"max_grad_norm": 0.5
    }
  },
  "workload": {
    "benchmark": "CEB",
    "path": "./experiment_results/workloads/gen_ceb/train_workloads1.pickle",
    "scale_factor": 1,
    "size": 16,
    "varying_frequencies": true,
    "training_instances": 10000,
    "validation_testing": {
      "number_of_workloads": 10,
      "unknown_query_probabilities": [0.0]
    },
    "similar_workloads": false,
    "excluded_query_classes": [],
    "unknown_queries": 0
  },
  "comparison_algorithms": [],
  "budgets": {
    "training": false,
    "validation_and_testing": [3, 5, 7, 10, 12, 15]
  },
  "column_filters": {
  }
}
